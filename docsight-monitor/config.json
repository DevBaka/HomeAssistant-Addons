{
  "name": "DOCSight Monitor",
  "version": "1.0.0",
  "slug": "docsight-monitor",
  "description": "Monitor your cable internet connection 24/7 and collect evidence for ISP complaints",
  "arch": ["amd64"],
  "startup": "application",
  "boot": "manual",
  "map": ["config:rw"],
  "host_network": false,
  "ports": {
    "8765/tcp": 8765
  },
  "ports_description": {
    "8765/tcp": "DOCSight web interface"
  },
  "options": {
    "log_level": "info"
  },
  "schema": {
    "log_level": "list(debug|info|warning|error)"
  }
}
