{
  "name": "Spotify Connect",
  "version": "1.0.0",
  "slug": "spotify-connect",
  "description": "Play Spotify music on your Home Assistant device",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "manual",
  "host_network": true,
  "audio": true,
  "ports": {
    "4070/tcp": 4070
  },
  "options": {
    "name": "Home Assistant",
    "bitrate": 160,
    "initial_volume": 50,
    "autoplay": true
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)?",
    "name": "str",
    "bitrate": "list(96|160|320)",
    "username": "str?",
    "password": "password?",
    "autoplay": "bool",
    "initial_volume": "match(^([0-9]|[1-9][0-9]|100)$)?"
  }
}
